# Staff portal password (required for /worker/* except login)
WORKER_PASSWORD=change-me-to-a-strong-secret

# Supabase — required for membership storage (API routes)
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key (Supabase Settings → API → "anon" / "publishable")
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# If you use the legacy name in the UI:
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Required in production: enables atomic `membership_store_append` and reliable writes
# (Settings → API → service_role — keep secret, server-only, never in client code).
SUPABASE_SERVICE_ROLE_KEY=
