# Staff portal password (required for /worker/* except login)
WORKER_PASSWORD=change-me-to-a-strong-secret

# Supabase — required for membership storage (API routes)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: use on Vercel/server only. Needed if you enable RLS on membership_store;
# the publishable key alone will not bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=
