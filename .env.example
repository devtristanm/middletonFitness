# Staff portal password (required for /worker/* except login)
WORKER_PASSWORD=change-me-to-a-strong-secret

# MongoDB Atlas (server-only — never expose in the browser)
# Create a cluster at https://www.mongodb.com/cloud/atlas → Connect → Drivers → copy URI.
# Replace <password> and include the database name before "?" e.g. ...mongodb.net/middleton_fitness?retryWrites=true
MONGO_DB_CONNECTION_STRING=
# Legacy alias (optional if MONGO_DB_CONNECTION_STRING is set)
# MONGODB_URI=
# Optional: override database name if it is not in the URI path
# MONGODB_DB_NAME=middleton_fitness
